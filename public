function toggleMobileDrawer() {
  const drawer = document.getElementById('mobile-drawer');
  const btn = document.getElementById('hamburger-btn');
  const isOpen = drawer.classList.contains('open');
  if (isOpen) {
    drawer.classList.remove('open');
    btn.classList.remove('open');
  } else {
    drawer.classList.add('open');
    btn.classList.add('open');
    updateMobileDrawerUser();
  }
}
function closeMobileDrawer() {
  document.getElementById('mobile-drawer').classList.remove('open');
  document.getElementById('hamburger-btn').classList.remove('open');
}
function updateMobileDrawerUser() {
  const u = getCurrentUser();
  const el = document.getElementById('mobile-drawer-user');
  if (!el) return;
  if (u) {
    el.innerHTML = `<span style="color:var(--accent);font-weight:700;font-size:0.9rem">👤 ${u.username}</span>
      <button class="btn btn-danger btn-sm" onclick="doLogout();closeMobileDrawer()">Đăng Xuất</button>`;
  } else {
    el.innerHTML = `<button class="btn btn-outline btn-sm" onclick="openModal('login-modal');closeMobileDrawer()">Đăng Nhập</button>
      <button class="btn btn-primary btn-sm" onclick="openModal('register-modal');closeMobileDrawer()">Đăng Ký</button>`;
  }
}
// Close drawer on outside click
document.addEventListener('click', function(e) {
  const drawer = document.getElementById('mobile-drawer');
  const btn = document.getElementById('hamburger-btn');
  if (drawer && drawer.classList.contains('open')) {
    if (!drawer.contains(e.target) && btn && !btn.contains(e.target)) closeMobileDrawer();
  }
  // Close user dropdown on outside click
  const wrap = document.getElementById('user-dropdown-wrap');
  if (wrap && !wrap.contains(e.target)) closeUserDropdown();
  // Close notif panel on outside click
  const nwrap = document.getElementById('notif-bell-wrap');
  if (nwrap && !nwrap.contains(e.target)) closeNotifPanel();
});

