function manualTopup(logId) {
  const logs = getCardLogs();
  const log = logs.find(l => l.id === logId);
  if (!log) return;
  const received = Math.round(log.amount * 0.95);
  const users = getUsers();
  const uidx = users.findIndex(u => u.username === log.username);
  if (uidx !== -1) {
    users[uidx].balance = (users[uidx].balance || 0) + received;
    saveUsers(users);
  }
  log.status = 1;
  saveCardLogs(logs);
  const txs = getTxs();
  txs.unshift({ id: genId(), username: log.username, type: 'topup', desc: `Nạp thẻ thủ công ${log.telco} ${fmtMoney(log.amount)}`, amount: received, status: 'success', time: now() });
  saveTxs(txs);
  renderAdminNapThe();
  toast(`Đã duyệt thủ công, cộng ${fmtMoney(received)} cho ${log.username}`, 'success');
}

