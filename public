async function submitCard() {
  if (!currentUser) { toast('Vui lòng đăng nhập!', 'error'); openModal('login-modal'); return; }
  const serial = document.getElementById('card-serial').value.trim();
  const code = document.getElementById('card-code').value.trim();
  const amount = document.getElementById('card-amount').value;
  if (!serial || !code) { toast('Nhập đầy đủ serial và mã thẻ!', 'error'); return; }

  const btn = document.getElementById('btn-napthe');
  btn.innerHTML = '<span class="spinner"></span> Đang xử lý...';
  btn.disabled = true;

  // Partner info
  const partnerId = '60034605186';
  const partnerKey = '83fcf6e737c746e2d2352bd8d55c430a';

  // Build request to doithe.vn API
  const sign = md5(`${partnerKey}${code}${serial}`);

  try {
    const payload = {
      telco: selectedNM,
      code, serial, amount,
      request_id: genId(),
      partner_id: partnerId,
      sign,
      command: 'charging'
    };

    const res = await fetch('/napthe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    const logs = getCardLogs();
    const log = {
      id: genId(), username: currentUser.username, telco: selectedNM,
      amount: parseInt(amount), serial, code, status: data.status,
      message: data.message, time: now(), transId: data.trans_id
    };
    logs.unshift(log);
    saveCardLogs(logs);

    if (data.status === 1 || data.status === 99) {
      // Success or pending
      const received = data.value || Math.round(parseInt(amount) * 0.95);
      const users = getUsers();
      const uidx = users.findIndex(u => u.username === currentUser.username);
      if (data.status === 1) {
        users[uidx].balance = (users[uidx].balance || 0) + received;
        saveUsers(users);
        currentUser.balance = users[uidx].balance;
      }
      updateNav();

      const txs = getTxs();
      txs.unshift({
        id: genId(), username: currentUser.username, type: 'topup',
        desc: `Nạp thẻ ${selectedNM} ${fmtMoney(amount)}`,
        amount: received, status: data.status === 1 ? 'success' : 'pending', time: now()
      });
      saveTxs(txs);

      if (data.status === 1) toast(`Nạp thẻ thành công! +${fmtMoney(received)} 🎉`, 'success');
      else toast('Thẻ đang xử lý, vui lòng chờ. Tiền sẽ được cộng sau khi xác nhận.', 'info');

      document.getElementById('card-serial').value = '';
      document.getElementById('card-code').value = '';
    } else {
      toast(`Nạp thẻ thất bại: ${data.message || 'Thẻ không hợp lệ'}`, 'error');
    }
  } catch (err) {
    // Fallback if CORS blocked
    toast('Không thể kết nối API. Vui lòng thử lại hoặc liên hệ admin.', 'error');
    const logs = getCardLogs();
    logs.unshift({ id: genId(), username: currentUser.username, telco: selectedNM, amount: parseInt(amount), serial, code, status: -1, message: 'Network error', time: now() });
    saveCardLogs(logs);
  }

  btn.innerHTML = '💳 NẠP THẺ NGAY';
  btn.disabled = false;
}

// MD5 implementation (real MD5, required for TSR/doithe API signing)
function md5(str) {
  function safeAdd(x,y){var lsw=(x&0xffff)+(y&0xffff),msw=(x>>16)+(y>>16)+(lsw>>16);return(msw<<16)|(lsw&0xffff);}
  function bitRotateLeft(num,cnt){return(num<<cnt)|(num>>>(32-cnt));}
  function md5cmn(q,a,b,x,s,t){return safeAdd(bitRotateLeft(safeAdd(safeAdd(a,q),safeAdd(x,t)),s),b);}
  function md5ff(a,b,c,d,x,s,t){return md5cmn((b&c)|((~b)&d),a,b,x,s,t);}
  function md5gg(a,b,c,d,x,s,t){return md5cmn((b&d)|(c&(~d)),a,b,x,s,t);}
