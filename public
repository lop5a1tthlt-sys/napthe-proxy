}

let pendingBuyId = null;

function openBuyModal(accId) {
  if (!currentUser) { toast('Vui lòng đăng nhập để mua acc!', 'error'); openModal('login-modal'); return; }
  const accs = getAccs();
  const acc = accs.find(a => a.id === accId);
  if (!acc) return;
  const avail = acc.items ? acc.items.filter(i => !i.sold).length : 0;
  if (avail === 0) { toast('Acc này đã hết hàng!', 'error'); return; }

  pendingBuyId = accId;
  const detail = document.getElementById('buy-acc-detail');
  detail.innerHTML = `
    <div class="acc-detail-row"><span class="acc-detail-key">Tên acc</span><span class="acc-detail-val">${acc.title}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Loại</span><span class="acc-detail-val">${acc.type || 'N/A'}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Còn lại</span><span class="acc-detail-val">${avail} acc</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Giá</span><span class="acc-detail-val" style="color:var(--accent3);font-size:1.1rem">${fmtMoney(acc.price)}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Số dư của bạn</span><span class="acc-detail-val">${fmtMoney(currentUser.balance||0)}</span></div>
  `;
  openModal('buy-acc-modal');
}

function confirmBuy() {
  if (!pendingBuyId || !currentUser) return;
  const users = getUsers();
  const userIdx = users.findIndex(u => u.username === currentUser.username);
  const accs = getAccs();
  const accIdx = accs.findIndex(a => a.id === pendingBuyId);
  if (accIdx === -1) { toast('Acc không tồn tại!', 'error'); return; }
  const acc = accs[accIdx];
  const avail = acc.items ? acc.items.filter(i => !i.sold) : [];
  if (avail.length === 0) { toast('Acc đã hết hàng!', 'error'); return; }

  const user = users[userIdx];
  if ((user.balance || 0) < acc.price) {
    closeModal('buy-acc-modal');
    toast(`Số dư không đủ! Cần thêm ${fmtMoney(acc.price - user.balance)}`, 'error');
    showPage('naptien');
    return;
  }

  // Deduct balance
  user.balance -= acc.price;
  // Mark acc item as sold
  const item = avail[0];
  item.sold = true;
  item.soldTo = currentUser.username;
  item.soldAt = now();
  acc.soldCount = (acc.soldCount || 0) + 1;
  users[userIdx] = user;
  saveUsers(users);
  saveAccs(accs);

  // Add transaction
  const txs = getTxs();
  txs.unshift({
    id: genId(), username: user.username, type: 'buy',
    desc: `Mua acc: ${acc.title}`, amount: -acc.price,
    status: 'success', time: now(), accInfo: item.info, accId: acc.id
  });
  saveTxs(txs);

  currentUser = user;
  setCurrentUser(user.username);
  updateNav();
  closeModal('buy-acc-modal');

  // Show result
  const resultEl = document.getElementById('acc-result-info');
  const [accUser, accPass] = (item.info || ':').split(':');
  resultEl.innerHTML = `
    <div class="acc-detail-row"><span class="acc-detail-key">Tên acc</span><span class="acc-detail-val">${acc.title}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Username</span><span class="acc-detail-val" style="color:var(--accent);font-size:1.05rem">${accUser || item.info}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Password</span><span class="acc-detail-val" style="color:var(--success);font-size:1.05rem">${accPass || 'N/A'}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Đã trả</span><span class="acc-detail-val" style="color:var(--accent3)">${fmtMoney(acc.price)}</span></div>
    <div class="acc-detail-row"><span class="acc-detail-key">Số dư còn lại</span><span class="acc-detail-val">${fmtMoney(user.balance)}</span></div>
  `;
  document.getElementById('acc-result-title').textContent = '🎉 MUA ACC THÀNH CÔNG!';
  document.getElementById('acc-result-emoji').style.display = '';
  openModal('acc-result-modal');
  toast('Mua acc thành công! 🎉', 'success');
}

