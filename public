<script type="module">
// ============================================================
// FIREBASE CONFIG & INIT
// ============================================================
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getDatabase, ref, get, set, onValue } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyAXsKfakhMNJepDAjnc5hC0fPh5pyq3PAU",
  authDomain: "shopvinhnebana-521be.firebaseapp.com",
  databaseURL: "https://shopvinhnebana-521be-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "shopvinhnebana-521be",
  storageBucket: "shopvinhnebana-521be.firebasestorage.app",
  messagingSenderId: "850952588616",
  appId: "1:850952588616:web:19198abe40f91c7f4cb77d"
};

const firebaseApp = initializeApp(firebaseConfig);
const firebaseDB = getDatabase(firebaseApp);

// ============================================================
// DATA LAYER (Firebase Realtime Database - đồng bộ mọi trình duyệt)
// ============================================================

// Cache local để truy xuất nhanh (giống localStorage cũ)
const _cache = {};

// Helper: Firebase lưu array như object {0:{},1:{}} → convert về array đúng
function toArray(val) {
  if (!val) return [];
  if (Array.isArray(val)) return val;
  if (typeof val === 'object') return Object.values(val);
  return [];
}

// Các path lưu dạng array
const ARRAY_PATHS = ['users','accs','transactions','caythu','caythu_orders','cardlogs','notifications'];

function normalizeVal(path, val) {
  if (ARRAY_PATHS.includes(path)) return toArray(val);
  return val; // settings là object bình thường
}

// Đọc dữ liệu từ Firebase (async, có cache)
async function fbGet(path) {
  try {
    const snap = await get(ref(firebaseDB, path));
    const raw = snap.exists() ? snap.val() : null;
    const val = normalizeVal(path, raw);
    _cache[path] = val;
    return val;
  } catch(e) {
    console.warn('Firebase get error:', e);
    return _cache[path] || (ARRAY_PATHS.includes(path) ? [] : null);
  }
}

// Ghi dữ liệu lên Firebase
async function fbSet(path, value) {
  try {
    _cache[path] = value;
    await set(ref(firebaseDB, path), value);
  } catch(e) {
    console.warn('Firebase set error:', e);
  }
}

// Lấy từ cache (đồng bộ) - dùng sau khi đã load
function fbCache(path) {
  const v = _cache[path];
  if (v === undefined || v === null) return ARRAY_PATHS.includes(path) ? [] : null;
  return v;
}

// ============================================================
// GETTER / SETTER - tương thích với code cũ
// ============================================================
function getUsers() { return fbCache('users') || []; }
function saveUsers(u) { fbSet('users', u); }
function getAccs() { return fbCache('accs') || []; }
function saveAccs(a) { fbSet('accs', a); }
function getTxs() { return fbCache('transactions') || []; }
function saveTxs(t) { fbSet('transactions', t); }
function getCayThu() { return fbCache('caythu') || []; }
function saveCayThuData(c) { fbSet('caythu', c); }
function getCayThuOrders() { return fbCache('caythu_orders') || []; }
function saveCayThuOrders(o) { fbSet('caythu_orders', o); }
function getSettings() { return fbCache('settings') || {}; }
function saveSettings2(s) { fbSet('settings', s); }
function getCardLogs() { return fbCache('cardlogs') || []; }
function saveCardLogs(l) { fbSet('cardlogs', l); }
function getCurrentUser() {
  try { return JSON.parse(localStorage.getItem('shop_current_user')); } catch { return null; }
}
function setCurrentUser(u) {
  localStorage.setItem('shop_current_user', JSON.stringify(u));
}

// ============================================================
// INIT DB - load toàn bộ data từ Firebase, sau đó khởi động app
// ============================================================
async function initDB() {
  // Hiện loading
  document.body.insertAdjacentHTML('afterbegin', `
    <div id="fb-loading" style="position:fixed;inset:0;background:#0a0a0f;z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;">
      <div style="font-family:'Orbitron',monospace;color:#00e5ff;font-size:1.3rem;font-weight:700;">🔥 Đang kết nối Firebase...</div>
      <div style="width:48px;height:48px;border:3px solid rgba(0,229,255,0.2);border-top-color:#00e5ff;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
    </div>`);

  // Load tất cả data song song
  await Promise.all([
    fbGet('users'),
    fbGet('accs'),
    fbGet('transactions'),
    fbGet('caythu'),
    fbGet('caythu_orders'),
    fbGet('settings'),
    fbGet('cardlogs'),
    fbGet('notifications'),
  ]);

  // Tạo admin nếu chưa có
  let users = getUsers();
  if (!users.find(u => u.username === 'admin')) {
    users.push({ username: 'admin', password: 'vinh0987609', role: 'admin', balance: 0, createdAt: now() });
    await fbSet('users', users);
    _cache['users'] = users;
  }

  // Lắng nghe thay đổi realtime từ Firebase (đồng bộ live)
  const paths = ['users','accs','transactions','caythu','caythu_orders','settings','cardlogs','notifications'];
  paths.forEach(path => {
    onValue(ref(firebaseDB, path), snap => {
      const raw = snap.exists() ? snap.val() : null;
      const val = normalizeVal(path, raw);
      _cache[path] = val;
      // Refresh UI nếu cần
      if (path === 'users' && currentUser) {
        const fresh = (val || []).find(u => u.username === currentUser.username);
        if (fresh) { currentUser = fresh; updateNav(); }
      }
      if (path === 'accs') { try { renderHome(); updateStats(); } catch{} }
      if (path === 'notifications') { try { updateNotifBadge(); } catch{} }
    });
  });

  // Ẩn loading và khởi động app
  document.getElementById('fb-loading').remove();
  initAuth();
  applySettings();
  renderHome();
  updateStats();
}

function now() { return new Date().toLocaleString('vi-VN'); }
function fmtMoney(n) { return Number(n).toLocaleString('vi-VN') + 'đ'; }
function genId() { return Date.now().toString(36) + Math.random().toString(36).substr(2, 5); }

// ============================================================
// AUTH
// ============================================================
let currentUser = null;

function initAuth() {
  const saved = getCurrentUser();
  if (saved) {
    const users = getUsers();
    const u = users.find(x => x.username === saved);
    if (u) { currentUser = u; updateNav(); }
  }
}

function doLogin() {
  const username = document.getElementById('login-user').value.trim();
  const password = document.getElementById('login-pass').value;
  if (!username || !password) { toast('Nhập đầy đủ thông tin!', 'error'); return; }
  const users = getUsers();
  const u = users.find(x => x.username === username && x.password === password);
  if (!u) { toast('Sai tên đăng nhập hoặc mật khẩu!', 'error'); return; }
  currentUser = u;
  setCurrentUser(u.username);
  closeModal('login-modal');
  updateNav();
  updateStats();
  toast(`Chào mừng, ${u.username}! 🎉`, 'success');
  if (u.role === 'admin') showPage('admin');
}

function doRegister() {
  const username = document.getElementById('reg-user').value.trim();
  const password = document.getElementById('reg-pass').value;
  const password2 = document.getElementById('reg-pass2').value;
  if (!username || !password) { toast('Nhập đầy đủ thông tin!', 'error'); return; }
  if (password !== password2) { toast('Mật khẩu không khớp!', 'error'); return; }
  if (username.length < 3) { toast('Tên đăng nhập tối thiểu 3 ký tự!', 'error'); return; }
  const users = getUsers();
  if (users.find(u => u.username === username)) { toast('Tên đăng nhập đã tồn tại!', 'error'); return; }
  const newUser = { username, password, role: 'user', balance: 0, createdAt: now() };
  users.push(newUser);
  saveUsers(users);
  currentUser = newUser;
  setCurrentUser(username);
  closeModal('register-modal');
  updateNav();
  toast('Đăng ký thành công! 🎉', 'success');
}

function doLogout() {
  currentUser = null;
  setCurrentUser(null);
  updateNav();
  showPage('home');
  toast('Đã đăng xuất!', 'info');
}

function updateNav() {
  const nr = document.getElementById('nav-right');
  if (currentUser) {
    // Refresh from DB
    const users = getUsers();
    const fresh = users.find(u => u.username === currentUser.username);
    if (fresh) currentUser = fresh;

    const adminItems = currentUser.role === 'admin' ? `
      <button class="user-dropdown-item admin-item" onclick="showPage('admin');closeUserDropdown()"><span class="di-icon">⚙️</span> Trang Admin</button>
      <button class="user-dropdown-item admin-item" onclick="openModal('refund-modal');closeUserDropdown()"><span class="di-icon">🔄</span> Hoàn Tiền</button>
      <div class="user-dropdown-sep"></div>
    ` : '';

    nr.innerHTML = `
      <div class="balance-badge">💰 <span id="balance-display">${fmtMoney(currentUser.balance||0)}</span></div>
      <div class="notif-bell-wrap" id="notif-bell-wrap">
        <button class="notif-bell-btn" id="notif-bell-btn" onclick="toggleNotifPanel()" aria-label="Thông báo">🔔<span class="notif-badge hidden" id="notif-count-badge">0</span></button>
      </div>
      <div class="user-dropdown-wrap" id="user-dropdown-wrap">
        <button class="user-avatar-btn" id="user-avatar-btn" onclick="toggleUserDropdown()" aria-label="Tài khoản">👤</button>
        <div class="user-dropdown" id="user-dropdown">
          <div class="user-dropdown-header">
            <div class="user-dropdown-name">👤 ${currentUser.username}</div>
            <div class="user-dropdown-balance">💰 ${fmtMoney(currentUser.balance||0)}</div>
          </div>
          ${adminItems}
          <button class="user-dropdown-item" onclick="showPage('naptien');closeUserDropdown()"><span class="di-icon">💳</span> Nạp Tiền</button>
          <button class="user-dropdown-item" onclick="showPage('history');closeUserDropdown()"><span class="di-icon">📋</span> Lịch Sử Giao Dịch</button>
          <div class="user-dropdown-sep"></div>
          <button class="user-dropdown-item danger" onclick="doLogout();closeUserDropdown()"><span class="di-icon">🚪</span> Đăng Xuất</button>
        </div>
      </div>
      <button class="hamburger" id="hamburger-btn" onclick="toggleMobileDrawer()" aria-label="Menu"><span></span><span></span><span></span></button>
    `;

    // Portal: đặt notif-panel ra body để tránh bị clip bởi nav overflow
    let existingPanel = document.getElementById('notif-panel');
    if (!existingPanel) {
      const panel = document.createElement('div');
      panel.className = 'notif-panel';
      panel.id = 'notif-panel';
      panel.innerHTML = `
        <div class="notif-panel-header">
          <span class="notif-panel-title">🔔 HỘP THƯ THÔNG BÁO</span>
          <button class="notif-mark-all" onclick="markAllNotifRead()">Đọc tất cả</button>
        </div>
        <div class="notif-list" id="notif-list"></div>
      `;
      document.body.appendChild(panel);
    }
  } else {
    nr.innerHTML = `
      <div class="balance-badge">💰 <span id="balance-display">0đ</span></div>
      <button class="btn btn-outline btn-sm" id="btn-login" onclick="openModal('login-modal')">Đăng Nhập</button>
      <button class="btn btn-primary btn-sm" id="btn-register" onclick="openModal('register-modal')">Đăng Ký</button>
      <button class="hamburger" id="hamburger-btn" onclick="toggleMobileDrawer()" aria-label="Menu"><span></span><span></span><span></span></button>
    `;
  }
  updateMobileDrawerUser();
  if (currentUser) setTimeout(updateNotifBadge, 50);
}

function toggleUserDropdown() {
  const drop = document.getElementById('user-dropdown');
  const btn = document.getElementById('user-avatar-btn');
  if (!drop) return;
  const isOpen = drop.classList.contains('open');
  if (isOpen) {
    drop.classList.remove('open');
    btn.classList.remove('open');
  } else {
    drop.classList.add('open');
    btn.classList.add('open');
  }
}

function closeUserDropdown() {
  const drop = document.getElementById('user-dropdown');
  const btn = document.getElementById('user-avatar-btn');
  if (drop) drop.classList.remove('open');
  if (btn) btn.classList.remove('open');
}

// Close user dropdown on outside click
document.addEventListener('click', function(e) {
  const wrap = document.getElementById('user-dropdown-wrap');
  if (wrap && !wrap.contains(e.target)) closeUserDropdown();
});

// ============================================================
// PAGES & MODALS
// ============================================================
function showPage(page) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('main-footer').style.display = (page === 'admin') ? 'none' : '';
  document.getElementById(page + '-page').classList.add('active');

  const pageMap = { home: 0, shop: 1, caythu: 2, naptien: 3, history: 4 };
  const btns = document.querySelectorAll('.nav-btn');
  if (pageMap[page] !== undefined) btns[pageMap[page]].classList.add('active');

  // Sync bottom nav
  document.querySelectorAll('.bottom-nav-item').forEach(b => b.classList.remove('active'));
  const bnMap = { home: 'bn-home', shop: 'bn-shop', caythu: 'bn-caythu', naptien: 'bn-naptien', history: 'bn-history' };
  if (bnMap[page]) { const el = document.getElementById(bnMap[page]); if (el) el.classList.add('active'); }
  // Hide bottom nav on admin page
  const bn = document.getElementById('bottom-nav');
  if (bn) bn.style.display = (page === 'admin') ? 'none' : '';

  if (page === 'home') { renderHome(); updateStats(); }
  if (page === 'shop') renderShop();
  if (page === 'caythu') renderCayThu();
  if (page === 'history') renderHistory();
  if (page === 'admin') {
    if (!currentUser || currentUser.role !== 'admin') { toast('Bạn không có quyền truy cập!', 'error'); showPage('home'); return; }
    renderAdmin();
  }
  if (page === 'naptien') renderBankInfo();
}

function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

// Close on overlay click
document.querySelectorAll('.modal-overlay').forEach(o => {
  o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); });
});

// ============================================================
// SETTINGS & APPEARANCE
// ============================================================
function applySettings() {
  const s = getSettings();
  if (s.shopName) {
    document.getElementById('page-title').textContent = s.shopName;
    document.getElementById('nav-shop-name').textContent = s.shopName;
    document.getElementById('hero-title').textContent = s.shopName;
  }
  if (s.logoData) {
    const img = document.getElementById('nav-logo-img');
    img.innerHTML = `<img src="${s.logoData}" style="width:36px;height:36px;border-radius:6px;object-fit:contain">`;
  }
}

function previewLogo(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    document.getElementById('logo-preview').innerHTML = `<img src="${ev.target.result}" style="width:60px;height:60px;border-radius:10px;object-fit:contain;border:1px solid var(--border)">`;
    window._pendingLogo = ev.target.result;
  };
  reader.readAsDataURL(file);
}

function saveSettings() {
  const s = getSettings();
  s.shopName = document.getElementById('set-shop-name').value.trim() || s.shopName;
  s.bankInfo = document.getElementById('set-bank').value.trim();
  if (window._pendingLogo) { s.logoData = window._pendingLogo; window._pendingLogo = null; }
  saveSettings2(s);
  applySettings();
  renderBankInfo();
  toast('Cài đặt đã lưu! ✅', 'success');
}

function loadSettingsForm() {
  const s = getSettings();
  document.getElementById('set-shop-name').value = s.shopName || '';
  document.getElementById('set-bank').value = s.bankInfo || '';
}

function renderBankInfo() {
  const s = getSettings();
  const el = document.getElementById('bank-details-content');
  if (el) {
    if (s.bankInfo) {
      el.innerHTML = s.bankInfo.split('\n').map(l => `<div>🔹 ${l}</div>`).join('');
    } else {
