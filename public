// Toggle / close notif panel
function toggleNotifPanel() {
  const panel = document.getElementById('notif-panel');
  if (!panel) return;
  const isOpen = panel.classList.contains('open');
  if (isOpen) { closeNotifPanel(); return; }

  // Định vị panel theo nút chuông
  const btn = document.getElementById('notif-bell-btn');
  if (btn) {
    const rect = btn.getBoundingClientRect();
    const isMobile = window.innerWidth <= 600;
    if (isMobile) {
      // Bottom sheet trên mobile
      panel.style.top = '';
      panel.style.right = '';
      panel.style.left = '0';
      panel.style.bottom = '0';
      panel.style.width = '100%';
      panel.style.maxHeight = '70vh';
      panel.style.borderRadius = '20px 20px 0 0';
    } else {
      // Desktop: dropdown từ nút chuông
      panel.style.top = (rect.bottom + window.scrollY + 10) + 'px';
      panel.style.right = (window.innerWidth - rect.right) + 'px';
      panel.style.left = '';
      panel.style.bottom = '';
      panel.style.width = '340px';
      panel.style.maxHeight = '480px';
      panel.style.borderRadius = '16px';
    }
  }

  panel.classList.add('open');
  const bd = document.getElementById('notif-backdrop');
  if (bd) bd.classList.add('show');
  renderNotifList();
}
function closeNotifPanel() {
  const panel = document.getElementById('notif-panel');
  if (panel) panel.classList.remove('open');
  const bd = document.getElementById('notif-backdrop');
  if (bd) bd.classList.remove('show');
}

// Count unread for current user
function countUnread() {
  if (!currentUser) return 0;
  const notifs = getNotifs();
  return notifs.filter(n => {
    const isForMe = n.type === 'broadcast' || n.target === currentUser.username;
    const readBy = n.readBy || [];
    return isForMe && !readBy.includes(currentUser.username);
  }).length;
}

function updateNotifBadge() {
  const badge = document.getElementById('notif-count-badge');
  if (!badge) return;
  const cnt = countUnread();
  if (cnt > 0) { badge.textContent = cnt > 99 ? '99+' : cnt; badge.classList.remove('hidden'); }
  else { badge.classList.add('hidden'); }
}

function renderNotifList() {
  const el = document.getElementById('notif-list');
  if (!el || !currentUser) return;
  const notifs = getNotifs().filter(n => n.type === 'broadcast' || n.target === currentUser.username);
  notifs.sort((a, b) => b.time - a.time);
  if (!notifs.length) {
    el.innerHTML = '<div class="notif-empty">📭 Chưa có thông báo nào</div>';
    return;
  }
  el.innerHTML = notifs.map(n => {
    const read = (n.readBy || []).includes(currentUser.username);
    const typeLabel = n.type === 'broadcast'
      ? '<span class="notif-type-broadcast">📢 Thông báo chung</span>'
      : '<span class="notif-type-private">📩 Thông báo riêng</span>';
    return `<div class="notif-item ${read ? '' : 'unread'}" onclick="markNotifRead('${n.id}')">
      <div class="notif-item-type">${typeLabel}</div>
      <div class="notif-item-msg"><b>${n.title||''}</b>${n.title ? '<br>' : ''}${n.msg}</div>
      <div class="notif-item-time">${n.timeStr}</div>
    </div>`;
  }).join('');
}

function markNotifRead(nid) {
  if (!currentUser) return;
  const notifs = getNotifs();
  const n = notifs.find(x => x.id === nid);
  if (!n) return;
  if (!(n.readBy || []).includes(currentUser.username)) {
    n.readBy = [...(n.readBy || []), currentUser.username];
    saveNotifs(notifs);
    updateNotifBadge();
    renderNotifList();
  }
}

function markAllNotifRead() {
  if (!currentUser) return;
  const notifs = getNotifs();
  notifs.forEach(n => {
    if (n.type === 'broadcast' || n.target === currentUser.username) {
      if (!(n.readBy || []).includes(currentUser.username))
        n.readBy = [...(n.readBy || []), currentUser.username];
    }
  });
  saveNotifs(notifs);
  updateNotifBadge();
  renderNotifList();
}

// Admin: select type
let _adminNotifType = 'broadcast';
function selectAdminNotifType(type) {
  _adminNotifType = type;
  document.getElementById('admin-notif-type-broadcast').classList.toggle('active', type === 'broadcast');
  document.getElementById('admin-notif-type-private').classList.toggle('active', type === 'private');
  document.getElementById('admin-notif-target-wrap').style.display = type === 'private' ? '' : 'none';
}

function populateNotifUserSelect() {
  const sel = document.getElementById('admin-notif-target');
  if (!sel) return;
  const users = getUsers().filter(u => u.role !== 'admin');
  sel.innerHTML = users.map(u => `<option value="${u.username}">${u.username}</option>`).join('');
}

function adminSendNotif() {
  const title = document.getElementById('admin-notif-title').value.trim();
  const msg = document.getElementById('admin-notif-msg').value.trim();
  if (!msg) { toast('Nhập nội dung thông báo!', 'error'); return; }
  const notifs = getNotifs();
  const entry = {
    id: genId(),
    type: _adminNotifType,
    target: _adminNotifType === 'private' ? document.getElementById('admin-notif-target').value : null,
    title, msg, readBy: [],
    time: Date.now(),
    timeStr: now()
  };
  notifs.unshift(entry);
  saveNotifs(notifs);
  document.getElementById('admin-notif-title').value = '';
  document.getElementById('admin-notif-msg').value = '';
  renderAdminNotif();
  toast(`Đã gửi thông báo ${_adminNotifType === 'broadcast' ? 'chung' : 'riêng'}! 📣`, 'success');
}

function renderAdminNotif() {
  populateNotifUserSelect();
  const notifs = getNotifs();
  notifs.sort((a, b) => b.time - a.time);
  const tbody = document.getElementById('admin-notif-tbody');
  if (!tbody) return;
  tbody.innerHTML = notifs.map(n => `
    <tr>
      <td>${n.timeStr}</td>
      <td>${n.type === 'broadcast' ? '<span class="badge badge-warning">📢 Chung</span>' : '<span class="badge badge-info">📩 Riêng</span>'}</td>
      <td>${n.type === 'broadcast' ? '<span style="color:var(--text2)">Tất cả</span>' : `<b>${n.target}</b>`}</td>
      <td>${n.title || '-'}</td>
      <td style="max-width:200px;word-break:break-word">${n.msg}</td>
      <td><button class="btn btn-danger btn-sm" onclick="deleteNotif('${n.id}')">🗑️</button></td>
    </tr>`).join('') || '<tr><td colspan="6"><div class="empty-state">Chưa có thông báo nào</div></td></tr>';
}

function deleteNotif(nid) {
  if (!confirm('Xoá thông báo này?')) return;
  saveNotifs(getNotifs().filter(n => n.id !== nid));
  renderAdminNotif();
  toast('Đã xoá thông báo!', 'info');
}

function openSendPrivateNotif(username) {
  document.getElementById('private-notif-user').value = username;
  document.getElementById('private-notif-title').value = '';
  document.getElementById('private-notif-msg').value = '';
  openModal('send-private-notif-modal');
}

function sendPrivateNotifFromModal() {
  const username = document.getElementById('private-notif-user').value;
  const title = document.getElementById('private-notif-title').value.trim();
  const msg = document.getElementById('private-notif-msg').value.trim();
  if (!msg) { toast('Nhập nội dung thông báo!', 'error'); return; }
  const notifs = getNotifs();
  notifs.unshift({ id: genId(), type: 'private', target: username, title, msg, readBy: [], time: Date.now(), timeStr: now() });
  saveNotifs(notifs);
  closeModal('send-private-notif-modal');
  toast(`Đã gửi thông báo riêng tới ${username}! 📩`, 'success');
}

