function processRefund() {
  const rUser = document.getElementById('refund-user').value.trim();
  const rPass = document.getElementById('refund-pass').value.trim();
  const resultEl = document.getElementById('refund-result');

  if (!rUser || !rPass) { toast('Nhập đầy đủ thông tin acc!', 'error'); return; }
  if (!currentUser || currentUser.role !== 'admin') { toast('Chỉ admin mới có quyền hoàn tiền!', 'error'); return; }

  const txs = getTxs();
  const buyTx = txs.find(t => t.type === 'buy' && t.accInfo && t.accInfo.startsWith(rUser + ':') && t.accInfo.endsWith(':' + rPass) || (t.type === 'buy' && t.accInfo === `${rUser}:${rPass}`));

  if (!buyTx) {
    resultEl.style.display = '';
    resultEl.innerHTML = `<div style="background:rgba(239,68,68,0.1);border:1px solid var(--danger);border-radius:10px;padding:12px;color:var(--danger);">❌ Không tìm thấy giao dịch mua acc với thông tin này!</div>`;
    return;
  }

  // Refund
  const users = getUsers();
  const uidx = users.findIndex(u => u.username === buyTx.username);
  const refundAmt = Math.abs(buyTx.amount);
  users[uidx].balance = (users[uidx].balance || 0) + refundAmt;
  saveUsers(users);

  txs.unshift({ id: genId(), username: buyTx.username, type: 'refund', desc: `Hoàn tiền acc: ${buyTx.desc}`, amount: refundAmt, status: 'success', time: now() });
  saveTxs(txs);

  resultEl.style.display = '';
  resultEl.innerHTML = `<div style="background:rgba(16,185,129,0.1);border:1px solid var(--success);border-radius:10px;padding:12px;color:var(--success);">✅ Đã hoàn ${fmtMoney(refundAmt)} cho user <b>${buyTx.username}</b>!</div>`;
  toast(`Hoàn tiền thành công cho ${buyTx.username}!`, 'success');
}

