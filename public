function accCardHTML(acc) {
  const avail = acc.items ? acc.items.filter(i => !i.sold).length : 0;
  const badgeHTML = acc.badge ? `<div class="acc-badge ${acc.badge}">${acc.badge === 'hot' ? '🔥 HOT' : acc.badge === 'new' ? '✨ NEW' : '💸 SALE'}</div>` : '';
  const specs = (acc.specs || []).map(s => `<div class="acc-spec">${s}</div>`).join('');
  const statusBadge = avail === 0 ? '<div class="badge badge-danger">Hết hàng</div>' : `<div class="badge badge-success">${avail} acc</div>`;
  return `
    <div class="acc-card" onclick="openBuyModal('${acc.id}')">
      ${badgeHTML}
      <div class="acc-card-header">
        <div class="acc-icon">${acc.icon || '🎮'}</div>
        <div>
          <div class="acc-title">${acc.title}</div>
          <div class="acc-subtitle">${acc.type || ''}</div>
        </div>
      </div>
      <div class="acc-card-body">
        ${specs ? `<div class="acc-specs">${specs}</div>` : ''}
        <div class="acc-price">${fmtMoney(acc.price)} <span>/ acc</span></div>
        <div class="flex items-center justify-between">
          ${statusBadge}
          <div class="acc-sold">Đã bán: ${acc.soldCount || 0}</div>
