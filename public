function saveAcc() {
  const editId = document.getElementById('edit-acc-id').value;
  const title = document.getElementById('acc-title').value.trim();
  const type = document.getElementById('acc-type').value.trim();
  const price = parseInt(document.getElementById('acc-price').value);
  const infoRaw = document.getElementById('acc-info').value.trim();
  const specsRaw = document.getElementById('acc-specs').value.trim();
  const icon = document.getElementById('acc-icon').value.trim() || '🎮';
  const badge = document.getElementById('acc-badge').value;

  if (!title || !price) { toast('Nhập đầy đủ thông tin!', 'error'); return; }

  const items = infoRaw.split('\n').filter(l => l.trim()).map(l => ({ id: genId(), info: l.trim(), sold: false }));
  const specs = specsRaw ? specsRaw.split(',').map(s => s.trim()).filter(Boolean) : [];

  const accs = getAccs();
  if (editId) {
    const idx = accs.findIndex(a => a.id === editId);
    if (idx !== -1) {
      // Preserve sold items
      const soldItems = accs[idx].items ? accs[idx].items.filter(i => i.sold) : [];
      accs[idx] = { ...accs[idx], title, type, price, items: [...soldItems, ...items], specs, icon, badge };
    }
  } else {
    accs.push({ id: genId(), title, type, price, items, specs, icon, badge, soldCount: 0, createdAt: now() });
  }
  saveAccs(accs);
  closeModal('add-acc-modal');
  document.getElementById('edit-acc-id').value = '';
  document.getElementById('add-acc-modal-title').textContent = '➕ THÊM ACC';
  renderAdminAcc();
  updateStats();
  toast('Đã lưu acc! ✅', 'success');
}

