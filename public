  function unescape(s){
    return decodeURIComponent(s.replace(/%([\da-f]{2})/gi,function(_,h){return String.fromCharCode(parseInt(h,16));}));
  }
  str = unescape(encodeURIComponent(str));
  var binaryStr = [];
  for(var i=0;i<str.length;i++){binaryStr.push(str.charCodeAt(i));}
  var M=[];
  var len=binaryStr.length;
  binaryStr.push(0x80);
  while(binaryStr.length%64!==56)binaryStr.push(0);
  var bits=len*8;
  binaryStr.push(bits&0xff,(bits>>8)&0xff,(bits>>16)&0xff,(bits>>24)&0xff,0,0,0,0);
  for(var i=0;i<binaryStr.length;i+=4)M.push(binaryStr[i]|(binaryStr[i+1]<<8)|(binaryStr[i+2]<<16)|(binaryStr[i+3]<<24));
