async function updateDonStatus(id, status) {
  const orders = getCayThuOrders();
  const idx = orders.findIndex(o => o.id === id);
  if (idx === -1) { toast('Không tìm thấy đơn!', 'error'); return; }

  orders[idx].status = status;
  orders[idx].updatedAt = now();

  if (status === 'cancel') {
    const o = orders[idx];
    const users = getUsers();
    const uidx = users.findIndex(u => u.username === o.username);
    if (uidx !== -1) {
      users[uidx].balance = (users[uidx].balance || 0) + o.price;
      await fbSet('users', users);
      _cache['users'] = users;
    }
    const txs = getTxs();
    txs.unshift({ id: genId(), username: o.username, type: 'refund', desc: `Hoàn tiền đơn cày thuê huỷ: ${o.pkgName}`, amount: o.price, status: 'success', time: now() });
    await fbSet('transactions', txs);
    _cache['transactions'] = txs;
    toast(`Đã huỷ và hoàn ${fmtMoney(o.price)} cho ${o.username}`, 'info');
  } else {
    toast('Đã cập nhật đơn thành Hoàn thành! ✅', 'success');
  }

  // Write orders và update cache ngay lập tức để tránh race condition
  await fbSet('caythu_orders', orders);
  _cache['caythu_orders'] = orders;
  renderAdminDon();
}

